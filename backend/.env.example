# Reference for Python or a private Compose env_file override; never commit real values.
DATA_DIR=/data
STOCKFISH_PATH=/app/vendor/stockfish
COOKIE_SECURE=1
PUBLIC_URL=https://chess.aura-server.org
GAMBIT_SEED_STARTER=1
# Optional local development only: GAMBIT_FRONTEND_DIR=/absolute/path/to/chess-site
# Features email and watch default OFF in the database. No provider is active.
SMTP_HOST=
SMTP_PORT=587
SMTP_FROM=
SMTP_USER=
SMTP_PASSWORD=
STREAMING_PROVIDER=
STREAMING_ALLOWED_HOSTS=
